+struct Timer {
+  double& total;
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  explicit Timer(double& total) : total(total) {}
+  ~Timer() { total += std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count(); }
